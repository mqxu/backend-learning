# ============================================================
# /etc/campus-activity/env —— 后端进程环境变量（systemd EnvironmentFile）
# ============================================================
# 部署位置：/etc/campus-activity/env
# 权限建议：chown root:root && chmod 600（只有 root 可读，systemd 以 root 读取后再降权运行）
# 初始化：由 deploy/init-server.sh 自动复制本模板；也可手工 cp deploy/env.example /etc/campus-activity/env
#
# 重要：本文件包含生产密钥，禁止提交到 Git，禁止随制品包上传。
#
# 映射原理：Spring Boot 会把环境变量按「大写 + 下划线」映射到配置项，
#   CAMPUS_JWT_SECRET   → campus.jwt.secret
#   CAMPUS_DEV_MODE     → campus.dev-mode
#   CAMPUS_SMS_EXPOSE_CODE → campus.sms.expose-code
#   LOGGING_LEVEL_COM_CAMPUS_ACTIVITY → logging.level.com.campus.activity
# 另外 application.yml 已显式声明了 ${MYSQL_*} / ${REDIS_*} / ${WX_*} / ${OSS_*} / ${CLOOPEN_*} 占位符。
# 所有值改成真实值后需要 `sudo systemctl restart campus-activity` 才生效。
# ============================================================

# ---------- JVM 参数 ----------
# -Xmx 按 ECS 内存调整：2C4G 建议 512m；2C8G 可到 1024m。systemd unit 里 ExecStart 会展开本变量。
JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC -Duser.timezone=Asia/Shanghai -Dfile.encoding=UTF-8"

# ---------- MySQL（对应 application.yml 的 spring.datasource.*） ----------
# 生产不要用 root，先在服务器上执行第 4 章的「创建专用账号」，再填到这里。
MYSQL_USERNAME=campus
MYSQL_PASSWORD=CHANGE_ME_db_password

# ---------- Redis（对应 spring.data.redis.*） ----------
# 与 01-14 其他案例共用实例时用 database 11 隔离；生产务必改强密码并禁止公网访问 6379。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_DATABASE=11

# ---------- 微信小程序（生产 dev-mode=false 时必填） ----------
WX_APPID=
WX_SECRET=

# ---------- 生产环境开关（Spring relaxed binding，等价于 application.yml 对应键） ----------
# 生产必须 false：true 时任何人都能用 devOpenId 冒充用户登录。
CAMPUS_DEV_MODE=false
# JWT 密钥：不少于 32 个字符的随机串，可用 `openssl rand -base64 48` 生成。
CAMPUS_JWT_SECRET=CHANGE_ME_at_least_32_chars_random_string
# 签到码 HMAC 密钥：与 JWT 密钥不同；多实例部署时必须一致。
CAMPUS_CHECKIN_SECRET=CHANGE_ME_another_random_string
# 短信通道：演示/课堂可用 mock，生产切 cloopen；生产必须把 expose-code 设为 false。
CAMPUS_SMS_PROVIDER=mock
CAMPUS_SMS_EXPOSE_CODE=false
# 文件存储：local 落 /opt/campus-activity/uploads；生产建议 oss（并配置下方 OSS_*）。
CAMPUS_FILE_STORAGE_TYPE=local
# 日志级别：生产 info；排障时临时改 debug，排查完改回。
LOGGING_LEVEL_COM_CAMPUS_ACTIVITY=info

# ---------- 短信真实通道（CAMPUS_SMS_PROVIDER=cloopen 时必填） ----------
# 容联云控制台获取；模板 ID 必须是审核通过的模板。
CLOOPEN_ACCOUNT_SID=
CLOOPEN_ACCOUNT_TOKEN=
CLOOPEN_APP_ID=
CLOOPEN_TEMPLATE_ID=1

# ---------- 阿里云 OSS（CAMPUS_FILE_STORAGE_TYPE=oss 时必填） ----------
# 缺任意一项，后端会以「storage-type 设为 oss，但 campus.file.oss.xxx 没有配置」启动失败。
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
# 可选：绑定自定义域名 / CDN 后填写，留空则用 bucket 默认域名拼地址。
OSS_DOMAIN=
