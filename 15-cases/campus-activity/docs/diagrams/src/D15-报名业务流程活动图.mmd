%% 活动图（Activity Diagram，带泳道）
%% 用途：需求规格说明书 02 图2-5，学生、系统、组织者三方在报名业务中的职责交接。
%% 说明：Mermaid 无 activityDiagram，用 flowchart + subgraph 表达泳道；
%%       实心圆为开始，双圆为结束，菱形为判断，出边均写条件。
flowchart TD
    S(( )):::sn

    subgraph L1["学生"]
        A1[提交报名]
        A2[绑定学号]
    end

    subgraph L2["系统"]
        B1{已绑定且在报名窗口?}
        B2{是否已报名?}
        B3{报名需审核?}
        B4{名额充足?}
        B6[写入报名成功]
        B7[写入候补队列]
        B8[写入待审核]
    end

    subgraph L3["组织者"]
        C1[审核报名]
    end

    E((( ))):::en

    S --> A1
    A1 --> B1
    B1 -- 未绑定 返回 10003 --> A2
    B1 -- 不在报名窗口 返回 20005 --> E
    A2 -- 绑定成功 --> A1
    B1 -- 通过 --> B2
    B2 -- 已报名 返回 30002 --> E
    B2 -- 未报名 --> B3
    B3 -- 需审核 --> B8
    B8 --> C1
    C1 -- 审核通过且占名额成功 --> B6
    C1 -- 驳回或名额不足 --> E
    B3 -- 无需审核 --> B4
    B4 -- 名额充足 --> B6
    B4 -- 名额已满且可候补 --> B7
    B4 -- 满员且未开候补 返回 30001 --> E
    B6 --> E
    B7 --> E

    classDef sn fill:#0F172A,stroke:#0F172A
    classDef en fill:#FFFFFF,stroke:#0F172A,stroke-width:2.6px
