    SYS_USER {
        bigint id PK
        varchar open_id UK
        varchar role
        tinyint status
    }

    STUDENT_PROFILE {
        bigint user_id PK
        varchar student_no UK
        varchar real_name
        varchar college
    }

    STUDENT_WHITELIST {
        bigint id PK
        varchar student_no UK
        tinyint used_flag
    }

    ORGANIZATION {
        bigint id PK
        varchar name
        tinyint type
    }

    ORG_MEMBER {
        bigint id PK
        bigint org_id FK
        bigint user_id FK
    }

    ACTIVITY_CATEGORY {
        bigint id PK
        varchar code UK
        varchar name
    }

    ACTIVITY {
        bigint id PK
        varchar title
        bigint org_id FK
        int capacity
        int signed_count
        tinyint status
    }

    ACTIVITY_SIGNUP {
        bigint id PK
        bigint activity_id FK
        bigint user_id FK
        tinyint status
        int waitlist_seq
    }

    ACTIVITY_CHECKIN {
        bigint id PK
        bigint signup_id FK
        tinyint checkin_type
        datetime checkin_time
    }

    ACTIVITY_FAVORITE {
        bigint id PK
        bigint activity_id FK
        bigint user_id FK
    }

    SYS_NOTICE {
        bigint id PK
        bigint user_id FK
        varchar type
        tinyint read_flag
    }

    AUDIT_RECORD {
        bigint id PK
        bigint biz_id
        varchar action
        bigint operator_id FK
    }
