{
  "openapi": "3.0.3",
  "info": {
    "title": "03 · 日志管理",
    "version": "1.0.0",
    "description": "backend-learning · 03-logging。由 tools/run-cases.mjs 依据实际运行的接口生成。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8003"
    }
  ],
  "tags": [
    {
      "name": "日志"
    }
  ],
  "paths": {
    "/logging/hello": {
      "get": {
        "tags": [
          "日志"
        ],
        "summary": "基础接口",
        "description": "先确认模块能正常响应，后面的日志都基于这条链路。",
        "operationId": "hello",
        "parameters": [],
        "responses": {
          "200": {
            "description": "实际返回",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/logging/demo": {
      "get": {
        "tags": [
          "日志"
        ],
        "summary": "日志级别与参数占位符演示",
        "description": "同一方法里打 info/warn/error 三条；对比占位符和字符串拼接两种写法。",
        "operationId": "demo",
        "parameters": [],
        "responses": {
          "200": {
            "description": "实际返回",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/logging/levels": {
      "get": {
        "tags": [
          "日志"
        ],
        "summary": "沿用上游传入的 traceId",
        "description": "请求头带 X-Trace-Id 时沿用该值，不再生成新的，这样跨服务调用能串成一条链路。",
        "operationId": "trace-passthrough",
        "parameters": [],
        "responses": {
          "200": {
            "description": "实际返回",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "traceId": {
                      "type": "string"
                    },
                    "已输出级别": {
                      "type": "string"
                    },
                    "被过滤级别": {
                      "type": "string"
                    },
                    "查看方式": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/logging/mask": {
      "get": {
        "tags": [
          "日志"
        ],
        "summary": "脱敏工具演示",
        "description": "手机号、身份证、邮箱、姓名四个字段在落日志前统一脱敏，响应里返回脱敏后的值。",
        "operationId": "mask",
        "parameters": [
          {
            "name": "phone",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "idCard",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "实际返回",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "phone": {
                      "type": "string"
                    },
                    "idCard": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/logging/error": {
      "get": {
        "tags": [
          "日志"
        ],
        "summary": "异常日志演示",
        "description": "error 只打一条并把异常对象作为最后一个参数传入，堆栈自动附上，不用手动 printStackTrace。",
        "operationId": "error",
        "parameters": [],
        "responses": {
          "500": {
            "description": "模拟业务异常"
          }
        }
      }
    }
  }
}