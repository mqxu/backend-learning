    "/public/ping": {
      "get": {
        "tags": [
          "综合案例"
        ],
        "summary": "探活接口",
        "description": "SecurityFilterChain 里 permitAll 的路径，不带头也能访问。",
        "operationId": "ping",
        "parameters": [],
        "responses": {
          "200": {
            "description": "服务状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      }
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
