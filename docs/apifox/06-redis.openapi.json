    "/sms/send": {
      "post": {
        "tags": [
          "缓存"
        ],
        "summary": "发送短信验证码",
        "description": "模拟通道下把验证码放在 data 里返回，方便本地联调；真实通道返回 null。后续所有接口都带上这里拿到的 token。",
        "operationId": "sms-send",
        "parameters": [
          {
            "name": "phone",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "实际返回",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/sms/login": {
      "post": {
        "tags": [
          "缓存"
        ],
        "summary": "重复使用验证码",
        "description": "同一个验证码再登录一次，被标记为已使用而拒绝。",
        "operationId": "sms-login-reuse",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "实际返回",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "data": {
                      "nullable": true
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
