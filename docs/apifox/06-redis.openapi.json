          }
        }
      }
    },
    "/redis/string": {
      "post": {
        "tags": [
          "缓存"
        ],
        "summary": "写入字符串",
        "description": "带过期时间写入，返回 TTL。缓存一定要设过期时间，否则异常情况下会永久占内存。",
        "operationId": "str-set",
        "parameters": [
          {
            "name": "key",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "value",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ttlSeconds",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 600
            }
          }
        ],
        "responses": {
          "200": {
            "description": "实际返回",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    },
                    "ttlSeconds": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "缓存"
        ],
        "summary": "读取字符串",
        "description": "读回上一步写入的值。",
        "operationId": "str-get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "实际返回",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
