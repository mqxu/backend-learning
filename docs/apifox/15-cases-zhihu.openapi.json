    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "综合案例"
        ],
        "summary": "登录",
        "description": "BCrypt 校验密码，签发 HS256 的 JWT。后续写操作都要带 Authorization: Bearer。",
