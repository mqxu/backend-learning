        "description": "匿名可看。登录后 followed 会变成 true/false 的真实状态，未登录恒为 false。",
        "operationId": "topics",
        "parameters": [],
        "responses": {
          "200": {
            "description": "六个话题与关注状态",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "integer"
                          },
                          "name": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "followersCount": {
                            "type": "integer"
                          },
                          "questionCount": {
                            "type": "integer"
                          },
                          "followed": {
                            "type": "boolean"
