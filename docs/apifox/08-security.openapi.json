      "get": {
        "tags": [
          "安全"
        ],
        "summary": "公开接口",
        "description": "permitAll 的路径不需要 token，用来放登录页、健康检查这类接口。",
        "operationId": "public",
        "parameters": [],
        "responses": {
          "200": {
            "description": "实际返回",
