{
  "openapi": "3.0.3",
  "info": {
    "title": "08 · 认证与授权",
    "version": "1.0.0",
    "description": "backend-learning · 08-security。由 tools/run-cases.mjs 依据实际运行的接口生成。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8008"
    }
  ],
  "tags": [
    {
      "name": "安全"
    }
