      "get": {
        "tags": [
          "安全"
        ],
        "summary": "未认证访问",
        "description": "没有 Authorization 头，由 JsonAuthenticationEntryPoint 返回 401，响应体是统一结构。",
        "operationId": "no-token",
        "parameters": [],
        "responses": {
          "401": {
            "description": "未登录"
          }
